APP_NAME=AI Export Sales Network
APP_VERSION=1.1.0
ENVIRONMENT=development
ADMIN_TOKEN=change-me
AGENT_CRON_TOKEN=
AI_PROVIDER=ensemble
AI_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_BASE_URL=
AI_MODEL=gpt-4.1-mini
AI_WEB_SEARCH=true
SEARCH_PROVIDER=serpapi
SEARCH_API_KEY=
SEARCH_BASE_URL=https://serpapi.com/search.json
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
DATABASE_URL=sqlite:///./data/export_sales.db
REPEAT_PROTECTION_DAYS=1095

# Buyer discovery searches public search results only; configure a licensed provider.
# SEARCH_PROVIDER=serpapi
# SEARCH_API_KEY=

# Stripe recurring subscriptions (leave blank to keep paid checkout disabled).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_STARTER=
STRIPE_PRICE_ID_GROWTH=
STRIPE_PRICE_ID_PREMIUM=
# Exact customer-visible monthly prices including currency, e.g. "$29 / month".
STRIPE_PRICE_DISPLAY_STARTER=
STRIPE_PRICE_DISPLAY_GROWTH=
STRIPE_PRICE_DISPLAY_PREMIUM=
# Absolute HTTPS URLs on your own deployed application.
BILLING_SUCCESS_URL=https://your-domain.example/market?billing=success&session_id={CHECKOUT_SESSION_ID}
BILLING_CANCEL_URL=https://your-domain.example/market?billing=cancel
BILLING_PORTAL_RETURN_URL=https://your-domain.example/market


# Separate human approval ledger secret; never reuse ADMIN_TOKEN
AGENT_APPROVER_TOKEN=
